<?xml version="1.0"?>
<Installer>
    <Name>XIV MIDI Studio</Name>
    <Version>4.5.0</Version>
    <Title>XIV MIDI Studio</Title>
    <Publisher>golgiApp</Publisher>
    <ProductUrl>https://github.com/golgiApp/MidiEditor</ProductUrl>
    <InstallerWindowIcon>package.png</InstallerWindowIcon>
    <Logo>midieditor.png</Logo>
    <RunProgram>@TargetDir@/XIVMidiStudio.exe</RunProgram>
    <RunProgramArguments/>
    <RunProgramDescription>Launch XIV MIDI Studio</RunProgramDescription>
    <StartMenuDir>XIV MIDI Studio</StartMenuDir>
    <AllowNonAsciiCharacters>true</AllowNonAsciiCharacters>
    <WizardStyle>Modern</WizardStyle>
    <WizardDefaultWidth>800</WizardDefaultWidth>
    <WizardDefaultHeight>450</WizardDefaultHeight>
    <ControlScript>controlscript.qs</ControlScript>

    <TargetDir>@HomeDir@/XIV MIDI Studio</TargetDir>
    <AdminTargetDir>@RootDir@/XIV MIDI Studio</AdminTargetDir>
</Installer>
